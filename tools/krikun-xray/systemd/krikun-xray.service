[Unit]
Description=Krikun Xray: SOCKS5 127.0.0.1:1080 (VLESS/Reality client, userspace)
After=network.target mgu-uplink.service
RequiresMountsFor=/var/opt

[Service]
# root: USB/import (setup.sh); основной процесс — uid 3922 (internet), без runas-бинарника
User=3922
Group=3922
ExecStartPre=+/bin/sh /var/opt/krikun-xray/current/setup.sh
ExecStart=/bin/sh /var/opt/krikun-xray/current/start.sh
RuntimeDirectory=krikun-xray
RuntimeDirectoryMode=0755
Restart=always
RestartSec=15
TimeoutStopSec=10
MemoryLimit=192M
CPUQuota=200%
# User=3922; NoNewPrivileges не включать.
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_SETUID CAP_SETGID
SystemCallArchitectures=native
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target