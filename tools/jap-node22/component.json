    "ru": {
      "title": "Node.js 22",
      "description": "Node 22 для миниатюр и API YouT/Filmix на ГУ (системный Node 8 BMW не трогаем)."
    }
  },
  "files": [
    {
      "path": "bin/node",
      "from": "build/node",
      "mode": "0755"
    },
    {
      "path": "LICENSE",
      "from": "build/LICENSE",
      "mode": "0644"
    },
    {
      "path": "check.sh",
      "from": "check.sh",
      "mode": "0755"
    }
  ],
  "check": ["check.sh"],
  "units": [],
  "enable": [],
  "recmgr": [],
  "restart": []
