{
  "schema": 1,
  "comment": "unit-apps: package/ в git, без build.py на ГУ (нет -ru.1 / oapgen / 64 MiB). Сервис YouT: jap-ridetube-d — только файлы внутри native/jap-ridetube-d/.",
  "components": [
    {
      "id": "krikun_seti",
      "kind": "app",
      "path": "apps/krikun_seti",
      "build": "unit",
      "icon": "icon.png",
      "mguHmi": ["ID7"]
    },
    {
      "id": "filmix_promax",
      "kind": "app",
      "path": "apps/filmix_promax",
      "build": "unit",
      "icon": "icon.png",
      "mguHmi": ["ID7"]
    },
    {
      "id": "jap_ridetube",
      "kind": "app",
      "path": "apps/jap_ridetube",
      "build": "unit",
      "icon": "icon.png",
      "mguHmi": ["ID7"]
    }
  ],
  "apps": {
    "path": "apps/*",
    "manifest": "app.json",
    "icon": "icon.png",
    "exclude": ["krikun_seti", "filmix_promax", "jap_ridetube"],
    "build": {
      "python": "kit/tools/build.py",
      "args": ["{id}", "--language", "ru"],
      "sdk": "oap-sdk",
      "output": "dist/{id}@{version}-ru.1.tgz",
      "shared": [
        "kit/runtime",
        "kit/platform",
        "kit/localization",
        "kit/tools/build.py",
        "kit/tools/pack_data.py",
        "kit/tools/localize.py",
        "kit/tools/locale-revisions.json",
        "kit/tools/oapgen",
        "oap-sdk"
      ]
    }
  },
  "tools": [
    {
      "id": "jap-node22",
      "path": "tools/jap-node22"
    },
    {
      "id": "krikun-xray",
      "path": "tools/krikun-xray"
    },
    {
      "id": "jap-ridetube-d",
      "path": "native/jap-ridetube-d"
    },
    {
      "id": "jap-filmix-d",
      "path": "native/jap-filmix-d"
    }
  ]
}