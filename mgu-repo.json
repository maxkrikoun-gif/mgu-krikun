{
  "schema": 1,
  "comment": "Единый Store-источник: ветка main. apps/* + tools (jap-node22, krikun-xray, daemons). Без дубля components[].",
  "apps": {
    "path": "apps/*",
    "manifest": "app.json",
    "icon": "icon.png",
    "exclude": [],
    "build": {
      "python": "kit/tools/build.py",
      "args": ["{id}", "--language", "ru"],
      "sdk": "oap-sdk",
      "output": "dist/{id}@{version}.tgz",
      "shared": [
        "kit/runtime",
        "kit/platform",
        "kit/localization",
        "kit/tools/build.py",
        "kit/tools/pack_data.py",
        "kit/tools/localize.py",
        "kit/tools/locale-revisions.json",
        "kit/tools/oapgen",
        "oap-sdk"
      ]
    }
  },
  "tools": [
    {
      "id": "jap-node22",
      "path": "tools/jap-node22"
    },
    {
      "id": "krikun-xray",
      "path": "tools/krikun-xray"
    },
    {
      "id": "jap-ridetube-d",
      "path": "native/jap-ridetube-d"
    },
    {
      "id": "jap-filmix-d",
      "path": "native/jap-filmix-d"
    }
  ]
}