{
  "schema": 1,
  "comment": "App Kit apps: package/ в git, на ГУ pack-staged-app.js (preparePackage), без oap_link.build / mgu-app.json на ветке.",
  "components": [
    {
      "id": "krikun_seti",
      "kind": "app",
      "path": "apps/krikun_seti",
      "build": {
        "node": "scripts/pack-staged-app.js",
        "args": ["{dir}"],
        "output": "{dir}/{id}@{version}.tgz",
        "shared": ["scripts/pack-staged-app.js", "tools/oap_pack.js"]
      },
      "icon": "icon.png",
      "mguHmi": ["ID7"]
    },
    {
      "id": "filmix_promax",
      "kind": "app",
      "path": "apps/filmix_promax",
      "build": {
        "node": "scripts/pack-staged-app.js",
        "args": ["{dir}"],
        "output": "{dir}/{id}@{version}.tgz",
        "shared": ["scripts/pack-staged-app.js", "tools/oap_pack.js"]
      },
      "icon": "icon.png",
      "mguHmi": ["ID7"]
    },
    {
      "id": "jap_ridetube",
      "kind": "app",
      "path": "apps/jap_ridetube",
      "build": {
        "node": "scripts/pack-staged-app.js",
        "args": ["{dir}"],
        "output": "{dir}/{id}@{version}.tgz",
        "shared": ["scripts/pack-staged-app.js", "tools/oap_pack.js"]
      },
      "icon": "icon.png",
      "mguHmi": ["ID7"]
    }
  ],
  "apps": {
    "path": "apps/*",
    "manifest": "app.json",
    "icon": "icon.png",
    "exclude": ["krikun_seti", "filmix_promax", "jap_ridetube"],
    "build": {
      "python": "kit/tools/build.py",
      "args": ["{id}", "--language", "ru"],
      "sdk": "oap-sdk",
      "output": "dist/{id}@{version}-ru.1.tgz",
      "shared": [
        "kit/runtime",
        "kit/platform",
        "kit/localization",
        "kit/tools/build.py",
        "kit/tools/pack_data.py",
        "kit/tools/localize.py",
        "kit/tools/locale-revisions.json",
        "kit/tools/oapgen",
        "oap-sdk"
      ]
    }
  },
  "tools": [
    {
      "id": "jap-node22",
      "path": "tools/jap-node22"
    },
    {
      "id": "krikun-xray",
      "path": "tools/krikun-xray"
    },
    {
      "id": "jap-ridetube-d",
      "path": "native/jap-ridetube-d"
    },
    {
      "id": "jap-filmix-d",
      "path": "native/jap-filmix-d"
    },
    {
      "id": "mgu-render-id7-touch",
      "path": "native/mgu-render-id7-touch",
      "optional": true
    }
  ]
}