# Пример для /var/opt/jap-wireproxy/conf/wireproxy.conf на ГУ
# Подставьте СВОИ ключи. Не коммитьте реальный файл.

[Interface]
Address = 10.66.66.2/32
PrivateKey = REPLACE_CAR_PRIVATE_KEY
DNS = 1.1.1.1

[Peer]
PublicKey = REPLACE_SERVER_PUBLIC_KEY
Endpoint = @ENDPOINT@
AllowedIPs = 0.0.0.0/0, ::/0
PersistentKeepalive = 25

[Socks5]
BindAddress = 127.0.0.1:1065